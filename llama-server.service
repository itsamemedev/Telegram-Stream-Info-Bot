# NIGHTCRAWLER-IK-LLAMA — Vorlage; eingerichtet wird sie von tools/ikllama.sh (v5.1-W181).
# Brain-LLM-Backend (Tier 4): ik_llama.cpp mit Qwen3-14B-Uncensored (Q4_K_M, rund 9 GB).
#
# Einrichten:  sudo bash tools/ikllama.sh   (entfernt ein altes llama.cpp ZUERST,
#              baut ik_llama.cpp, laedt und prueft das Modell, schreibt diese
#              Unit nach /etc/systemd/system/ und wartet auf /health)
# Pruefen:     bash tools/ikllama.sh --check
#
# Die Zeile oben ist die Kennung, an der das Werkzeug den EIGENEN Dienst vom
# alten llama.cpp unterscheidet — beide heissen llama-server.service. Wer diese
# Datei von Hand kopiert, behaelt sie.
#
#   -t 4        4 der 8 Kerne — ffmpeg und Whisper brauchen den Rest; Nice=10
#               und CPUWeight=50: Restreams haben immer Vorrang vor der KI.
#   -c 8192     4096 reicht nicht fuer Verlauf + Frage + 1024-Token-Antwort (W110).
#   -ngl 0      reiner CPU-Betrieb; die Vorgabe von ik_llama.cpp ist 999.
#   -rtr        Gewichte beim Laden verschraenkt umpacken — schneller auf der CPU,
#               legt das Modell dafuer ganz in den RAM (daher MemoryMax).
#   --jinja     Chat-Vorlage aus dem Modell; nur damit wirkt enable_thinking=false,
#               das brain/llm.py mitschickt (Qwen3 denkt sonst vor jeder Antwort).
#   --webui llamacpp  die Chat-Oberflaeche mit dem Reiter „MCP" (v5.6-W197);
#               ohne Angabe zeigt ik_llama.cpp die alte ohne MCP. Steht hier
#               NICHT in ExecStart: ein Build ohne den Schalter startete sonst
#               nicht. tools/ikllama.sh setzt ihn, wenn das Programm ihn kennt
#               (LLM_WEBUI), den CORS-Proxy fuer MCP-Server nur mit
#               LLM_WEBUI_MCP_PROXY=1. Von Hand: ans Ende von ExecStart haengen.
#   KEIN --embeddings: laut Server-Doku beschraenkt der Schalter den Server auf
#               Embeddings; /health waere gruen, der Chat nicht (W110).
#               Embeddings kommen von einem EIGENEN Server (BRAIN_EMBED_URL).
#   Flash-Attention ist bei ik_llama.cpp ab Werk an (-fa), -fmoe betrifft nur
#   MoE-Modelle — Qwen3-14B ist dicht. Beides steht deshalb nicht hier.
[Unit]
Description=ik_llama.cpp Server (NIGHTCRAWLER Brain-LLM, Qwen3-14B-Uncensored.Q4_K_M)
After=network.target

[Service]
Type=simple
ExecStart=/opt/ik_llama.cpp/build/bin/llama-server -m /opt/models/Qwen3-14B-Uncensored.Q4_K_M.gguf -a qwen3-14b-uncensored.q4_k_m --host 127.0.0.1 --port 8080 -t 4 -c 8192 -ngl 0 -rtr --jinja --no-warmup
Nice=10
CPUWeight=50
MemoryMax=13G
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
