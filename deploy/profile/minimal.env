# titel: Minimal — nur ueberwachen und aufnehmen
# beschreibung: Live-Erkennung, Aufnahme und Telegram. Kein Restream, keine KI, die von sich aus spricht oder Clips schneidet. Der Bot laeuft so auch auf einem Pi.
#
# NIGHTCRAWLER — Nutzungsprofil (v4.2-W129). Gelesen von tools/installer.sh
# (--profile minimal oder die Frage "Nutzungsprofil"). Jede Zeile ist ein
# Schalter, den es im Bot gibt — der Vertrag _test_v42_w129_profile haelt
# jeden Namen gegen .env.example. Was hier NICHT steht, bleibt, wie es ist.

# Restream aus — "auto" schaltete ein, sobald ein Ziel-Key in der .env steht.
RESTREAM_ENABLED=0
# Sprachreaktion aus: kein zweiter ffmpeg je Live-Nutzer, kein Whisper.
LIVE_REACT_ENABLED=0
# AZRAEL spricht nicht von sich aus: keine Chat-Antworten, kein Co-Host, kein
# Fuellen von Funkstille, kein Oracle.
AZRAEL_CHAT_REPLY=0
AZRAEL_COHOST=0
PROACTIVE_ENABLED=0
ORACLE_ENABLED=0
# Keine Hype-Erkennung und keine automatischen Clips — beides liest die
# laufende Aufnahme mit und kostet CPU.
DIRECTOR_ENABLED=0
HYPE_CLIP_AUTO=0
CLIP_ENABLED=0
MEME_CLIP_ENABLED=0
