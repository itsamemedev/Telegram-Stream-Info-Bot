# titel: Viel KI — AZRAEL als Co-Host
# beschreibung: AZRAEL hoert mit (Whisper), antwortet im Chat, fuellt Funkstille und reagiert auf das Gesprochene. Braucht faster-whisper (tools/update.sh installiert es) und ein lokales oder Cloud-LLM.
#
# NIGHTCRAWLER — Nutzungsprofil (v4.2-W129). Siehe minimal.env.

# Sprachreaktion: ffmpeg zapft das Stream-Audio, faster-whisper schreibt mit,
# AZRAEL reagiert. Ab Werk AUS, weil es je Live-Nutzer einen Prozess kostet.
LIVE_REACT_ENABLED=1
LIVE_REACT_SPEECH=1
# Antworten im Chat — nur bei direkter Ansprache, mit Cooldown und
# Sentinel-Pruefung vor jeder Antwort (bot.py, V37-TWCHAT).
AZRAEL_CHAT_REPLY=1
AZRAEL_REACT_TO_CHAT=1
# Co-Host, Funkstille fuellen, Oracle mit Gedaechtnis.
AZRAEL_COHOST=1
PROACTIVE_ENABLED=1
ORACLE_ENABLED=1
# Hype-Momente erkennen — die Grundlage fuer Co-Host und Highlights.
DIRECTOR_ENABLED=1
